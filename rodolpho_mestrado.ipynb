# ==========================================
# Importação das bibliotecas
# ==========================================
import pandas as pd
from scipy.stats import fisher_exact

# ==========================================
# Importar arquivo CSV da pasta do notebook
# ==========================================
# Substitua pelo nome do seu arquivo
arquivo_csv = "2023_FUMES_padronizado"

# Ler arquivo CSV
df = pd.read_csv(arquivo_csv)

# Visualizar primeiras linhas (opcional)
print("Primeiras linhas da base:")
display(df.head())

# ==========================================
# Selecionar variáveis para o teste
# Exemplo:
# setor (DASAC/DASMI)
# afastamento (SIM/NAO)
# ==========================================

coluna_setor = "Local de Trabalho"
coluna_afastamento = "Afastamento"

# Padronizar texto para evitar problemas
df[coluna_setor] = df[coluna_setor].astype(str).str.upper().str.strip()
df[coluna_afastamento] = (
    df[coluna_afastamento]
    .astype(str)
    .str.upper()
    .str.strip()
)

# ==========================================
# Criar tabela de contingência
# ==========================================
tabela = pd.crosstab(
    df[coluna_setor],
    df[coluna_afastamento]
)

print("\nTabela de contingência:")
print(tabela)

# ==========================================
# Garantir tabela 2x2
# ==========================================
if tabela.shape != (2, 2):
    raise ValueError(
        f"O teste de Fisher do scipy requer uma tabela 2x2. "
        f"A tabela atual possui dimensão {tabela.shape}"
    )

# ==========================================
# Teste Exato de Fisher
# ==========================================
odds_ratio, p_value = fisher_exact(tabela)

print("\n===== TESTE EXATO DE FISHER =====")
print(f"Odds Ratio: {odds_ratio:.4f}")
print(f"Valor-p: {p_value:.4f}")

# ==========================================
# Interpretação simples
# ==========================================
alpha = 0.05

if p_value < alpha:
    print("\nConclusão:")
    print("Existe associação estatisticamente significativa "
          "entre as variáveis (p < 0,05).")
else:
    print("\nConclusão:")
    print("Não há evidência de associação estatisticamente "
          "significativa entre as variáveis (p ≥ 0,05).")
